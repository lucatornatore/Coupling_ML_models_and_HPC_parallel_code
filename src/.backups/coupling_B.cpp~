// ---------------------------------------------------------------------
//  src/coupling_B.cpp -- Case B coupling implementation.
//
//  Case B reserves a contiguous block of MPI_COMM_WORLD ranks as the
//  inference pool; the remaining ranks ("physics ranks") read the
//  snapshot, build particle batches, and send each batch as a query
//  to one assigned inference rank, then block on the answer.  This
//  is the first of the two true coupling cases (the other being C);
//  case A's "every rank does inference locally" was the baseline.
//
//  Layout (world size N, pool size P, 1 <= P < N):
//      ranks  [0       , N - P)  : physics (own particles)
//      ranks  [N - P   , N    )  : inference (own no particles)
//
//  Assignment: physics rank at position p (0..N-P-1) in physics_comm
//  is routed to inference rank `(N - P) + (p % P)` in MPI_COMM_WORLD.
//  Round-robin keeps load balanced when P does not divide N - P.
//
//  Wire format is defined in include/mlhpc/detail/coupling_wire.hpp
//  and is shared verbatim with case C; see that header for the
//  message layout and tag conventions.
//
//  Shutdown protocol: each physics rank, in its `shutdown()` call,
//  sends a one-shot QueryHeader with the HDR_SHUTDOWN flag bit set
//  to its assigned inference rank.  Each inference rank knows how
//  many physics ranks are assigned to it (`expected_queries()`); its
//  `serve()` loop exits when it has counted that many shutdowns.
//
//  Empty-quota pool members: an inference rank whose pool index has
//  `expected_queries() == 0` (which happens when pool_size > number
//  of physics ranks, possible at the boundary) returns from `serve()`
//  immediately.  Without this short-circuit it would block forever on
//  a Recv that nobody will satisfy.
//
//  Timing breakdown (filled into `Timings` per rank):
//      physics:   send  = MPI_Send (header + payload) time
//                 wait  = MPI_Recv (answer) time
//                 kernel = 0    (kernel does not run on physics)
//                 total = send + wait
//      inference: wait  = MPI_Recv (header + payload) time
//                 kernel = backend.batch_inference time
//                 send  = MPI_Send (answer) time
//                 total = wait + kernel + send  (per iteration)
//      Both:      n_calls counts processed batches; shutdown sentinels
//                 are NOT counted as work.
//
//  Future tightening (deferred): non-blocking sends to overlap with
//  packing, persistent communication (MPI_Send_init), shared-memory
//  windows for the physics-rank-to-inference-rank path when both
//  live on the same node (this is the main case-C optimisation; see
//  coupling_C.cpp once implemented).
// ---------------------------------------------------------------------

#include "mlhpc/coupling.hpp"

#include "mlhpc/detail/coupling_wire.hpp"
#include "mlhpc/inference.hpp"
#include "mlhpc/particle_batch.hpp"
#include "mlhpc/types.hpp"

#include <mpi.h>

#include <cstdio>
#include <cstdlib>
#include <memory>
#include <stdexcept>
#include <vector>

namespace mlhpc
