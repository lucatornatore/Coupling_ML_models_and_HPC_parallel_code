// ---------------------------------------------------------------------
//  src/io_gadget2.cpp -- implementation of mlhpc::GadgetReader2.
//
//  Implements the Format-2 reader described in ioformat.md sec. 1.
//  The file is walked record-by-record using fseek/fread on a stdio
//  FILE*; that is sufficient for this single-file reader and avoids
//  any iostream overhead.
//
//  Endianness model:
//      The first 4 bytes of any Format-2 file are a Fortran record
//      marker whose *value* is the size of the label record == 8 in
//      every well-formed file.  We read it in native byte order; if
//      it comes out 8 the file matches the host's endianness, if it
//      comes out 0x08000000 it is byte-swapped.  Any other value is
//      a hard error.  Once detected, the swap flag is sticky for
//      the lifetime of this reader.
//
//  Error policy:
//      Every parse/I/O issue throws std::runtime_error.  Returning
//      bool/error codes from every helper here would clutter the
//      hot path; exceptions are caught at the top-level entry
//      points of the harness.
// ---------------------------------------------------------------------

#include "mlhpc/io_gadget2.hpp"

#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <stdexcept>
#include <string>

